@startuml
!include style.puml
skinparam ArrowFontStyle plain
hide stereotype

skinparam sequenceParticipant<<padding>> {
    BackgroundColor transparent
    BorderColor transparent
    FontColor transparent
}
skinparam sequenceLifeLineBorderColor<<padding>> transparent

participant " " as LeftPadding <<padding>>

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "a:AddCommand" as AddCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "u:UnindexedPerson" as UnindexedPerson MODEL_COLOR
participant "p:Person" as Person MODEL_COLOR
end box

[-> LogicManager : execute(a)
activate LogicManager
LogicManager -> AddCommand : execute(m)
activate AddCommand
AddCommand -> Model : addPerson(u)
activate Model

note left of UnindexedPerson
Validated contact details
without a storage index.
end note

create Person
Model -> Person : withPersonIndex()
activate Person
Person --> Model : indexed person
deactivate Person
Model -> Model : insert into name bucket
note left of Person
The model assigns the smallest
available zero-based index.
The bucket and flattened list
are then refreshed.
end note
Model --> AddCommand : indexed person
deactivate Model

create CommandResult
AddCommand -> CommandResult : success message
activate CommandResult
CommandResult --> AddCommand
deactivate CommandResult
AddCommand --> LogicManager : r
deactivate AddCommand
[<--LogicManager
deactivate LogicManager
@enduml
